module Lab1 where
import Daml.Script

quadFunction: Int -> Int -> Int -> Int
quadFunction x y z = (3 * ( x * x)) + (2*y) + z

quadLambda : Int -> Int -> Int -> Int
quadLambda = \x y z -> (3 * ( x * x)) + (2*y) + z


-- problem 2
doubleMe: Int -> Int
doubleMe x = x + x
add: Int -> Int -> Int
add x y = x + y
doubleUs: Int -> Int -> Int 
doubleUs x y = doubleMe x `add` doubleMe y



testLab1: Script ()
testLab1 = script do 
    debug $ quadFunction 1 2 3
    debug $ quadLambda 1 2 3
    debug $ doubleMe 3
    debug $ doubleUs 3 4
